# Copy to .env for local development. Production values live in Vercel's
# project settings, not in a committed file. Local dev and production share
# one database, so local testing touches real rows.

# Postgres (Prisma). The shadow database is only used by `prisma migrate dev`.
DATABASE_URL=
SHADOW_DATABASE_URL=

# Auth.js: `npx auth secret` generates one.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude Haiku for task scoring and announcement checks. Without it the app
# falls back to a local Ollama server (OLLAMA_URL / OLLAMA_MODEL, optional).
ANTHROPIC_API_KEY=
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# YouTube Data API v3 key, for importing playlists into Comms.
YOUTUBE_DATA_API_KEY=

# Comma-separated emails allowed into /dev and /api/dev/*.
DEV_ACCOUNT_EMAILS=
