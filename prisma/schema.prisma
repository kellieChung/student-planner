generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            String                         @id @default(cuid())
  name                          String?
  email                         String?                        @unique
  emailVerified                 DateTime?
  image                         String?
  passwordHash                  String?
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  ageConfirmedAt                DateTime?
  accounts                      Account[]
  sessions                      Session[]
  extensionSessions             ExtensionSession[]
  canvasCourses                 CanvasCourse[]
  deletedCanvasCourses          DeletedCanvasCourse[]
  assignments                   Assignment[]
  discussions                   Discussion[]
  announcements                 Announcement[]
  musicPlaylists                MusicPlaylist[]
  taskCustomizations            TaskCustomization[]
  gamificationState             GamificationState?
  announcementSuggestionReviews AnnouncementSuggestionReview[]
  customTasks                   CustomTask[]
  recurringTasks                RecurringTask[]
  taskPlanningEstimates         TaskPlanningEstimate[]
  procrastinationRecords        ProcrastinationRecord[]
  townState                     TownState?
  worldLayout                   WorldLayout?
  plannerSettings               PlannerSettings?
  aiTaskEvents                  AiTaskEvent[]
  starChart                     StarChart?
  chartedStars                  ChartedStar[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExtensionSession {
  id        String   @id @default(cuid())
  token     String   @unique
  state     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CanvasCourse {
  id           String   @id @default(cuid())
  canvasId     String
  canvasOrigin String
  name         String
  // User-controlled: hide a course Canvas still reports as active (e.g. a
  // teacher never concluded it) without it reappearing on the next sync.
  hidden       Boolean  @default(false)
  // User rename override — sync (app/api/canvas/sync/route.ts) always
  // overwrites `name` from Canvas, so a rename has to live in a column
  // sync never touches, same reasoning as `hidden` above.
  displayName  String?
  // User-editable short code shown on planner cards (e.g. "MA" for a
  // course named "Calculus BC") — unset means "use the auto-derived
  // default" (lib/taskLabel.ts's courseAbbreviationDefault).
  abbreviation String?
  // User-editable hex color (e.g. "#3b82f6") for the course badge shown on
  // planner cards — unset means "use the auto-derived default"
  // (components/AssignmentCard.tsx's courseColorFor hash).
  color        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments   Assignment[]
  discussions   Discussion[]
  announcements Announcement[]

  @@unique([userId, canvasOrigin, canvasId])
  @@index([userId])
}

// Tombstones a user's explicit "Delete" of a CanvasCourse (see
// app/api/courses/[courseId]/route.ts's DELETE handler) so a later sync
// doesn't silently recreate it just because Canvas still reports the
// course active. Not a foreign key to CanvasCourse — the whole point is
// that row no longer exists. Only the extension's explicit "Restore
// Course" flow (app/api/canvas/restore-course/route.ts) removes a row
// here; a routine sync's pruning step (app/api/canvas/sync/route.ts) never
// writes one, since a course dropping off Canvas's active list is a
// different event from the user rejecting it and shouldn't be permanently
// blocked from ever syncing back in.
model DeletedCanvasCourse {
  id           String   @id @default(cuid())
  canvasOrigin String
  canvasId     String
  deletedAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canvasOrigin, canvasId])
  @@index([userId])
}

model Assignment {
  id          String    @id @default(cuid())
  canvasId    String
  name        String
  description String?
  dueAt       DateTime?
  htmlUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   CanvasCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([userId])
}

model Discussion {
  id        String    @id @default(cuid())
  canvasId  String
  title     String
  message   String?
  htmlUrl   String?
  postedAt  DateTime?
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   CanvasCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([userId])
}

model Announcement {
  id        String    @id @default(cuid())
  canvasId  String
  title     String
  message   String?
  htmlUrl   String?
  postedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // sha256 of title+message as of the last successful AI extraction +
  // duplicate-check pass; a match means the detection pass skips this
  // announcement (never pays twice for unchanged text). Deliberately not
  // written by Canvas sync's upsert, so it survives re-syncs.
  aiAnalyzedHash String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   CanvasCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([userId])
}

// Persists every AI-proposed announcement task detected by a manual
// "Check for new announcements" pass (see AutoTaskCreation.md's "rundown"
// model), not just decided ones — a ProposedTask is otherwise fully
// ephemeral, so without this a "pending" candidate couldn't survive
// between sessions to reappear in the Rundown screen. Not a foreign key
// to Announcement (same free-form-id precedent as TaskCustomization
// below) — a review decision shouldn't evaporate if an announcement row
// is ever deleted by some future cleanup feature, even though sync
// currently only upserts and never deletes.
model AnnouncementSuggestionReview {
  id                   String    @id @default(cuid())
  sourceAnnouncementId String
  // Content-derived hash (lib/suggestionKey.ts) — a ProposedTask has no
  // id of its own, and a positional index isn't stable across re-runs of
  // the extraction prompt.
  suggestionKey        String
  status               String // "pending" | "accepted" | "rejected" | "maybe"
  // Full ProposedTask as detected, so the Rundown/Still-Deciding screens
  // can render a "pending"/"maybe" candidate without re-running the AI
  // pipeline. Null for legacy accepted/rejected rows written before this
  // existed — callers must treat null as "nothing to render," never
  // re-derive it.
  taskSnapshot         Json?
  // Set only when status transitions into "accepted"/"rejected" — lets a
  // "maybe" item's time-parked duration be read directly off this row.
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceAnnouncementId, suggestionKey])
  @@index([userId])
  @@index([userId, status])
}

model TaskCustomization {
  id            String    @id @default(cuid())
  // Free-form task id: either a Canvas-synced Assignment.id or a client-
  // generated "custom-<timestamp>" id. Not a foreign key — custom tasks
  // have no DB row of their own, so ownership is enforced purely by
  // scoping every query by userId, same as everywhere else in this file.
  taskId        String
  startAt       DateTime?
  // Only meaningfully set for Canvas-synced tasks — custom tasks already
  // store their own course directly on their localStorage object.
  course        String?
  // Full task-name override — Canvas sync (lib/canvasIngest.ts) would
  // otherwise overwrite Assignment.name on every resync. Also only
  // meaningfully set for Canvas-synced tasks, same reasoning as `course`.
  nameOverride  String?
  // Overrides the card's classified type code (HW/R/EXAM/TODO,
  // lib/taskLabel.ts's LabelType) when classifyLabelType guesses wrong.
  typeOverride  String?
  // Overrides the resolved due instant (UTC) — Canvas sync would
  // otherwise overwrite Assignment.dueAt on every resync.
  dueAtOverride DateTime?
  notes         String?
  // Completion + deletion state, for ANY task (Canvas-synced or custom) —
  // was localStorage-only (task_states/deleted_task_ids), which is why it
  // never carried over between browser profiles for the same account.
  // `deleted` is only meaningful for a Canvas-synced task (a hidden-from-
  // planner tombstone); a deleted custom task is a real CustomTask row
  // delete instead, no tombstone needed.
  completed     Boolean   @default(false)
  completedAt   DateTime?
  // Set while a task has been started but not finished — cleared whenever
  // `completed` becomes true. No timestamp: nothing downstream needs
  // "when did I start it," and adding one to the startAt/completedAt
  // fallback chain in WeeklyPlannerView.tsx's grid-span calculation would
  // reopen the exact date-serialization NaN-column bug fixed there before.
  inProgress    Boolean   @default(false)
  deleted       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

// The core identity of a manually-added/AI-accepted task — was 100%
// client-side (localStorage "custom_tasks"), which is why it never
// carried over between browser profiles for the same account. `id` is
// client-supplied (not @default(cuid())), not auto-generated: dozens of
// call sites test id.startsWith("custom-") (isCustomTask checks
// throughout WeeklyPlannerView.tsx/EditTaskModal.tsx), and
// TaskCustomization.taskId's comment already documents accepting exactly
// this id shape — keeping it preserves that convention.
model CustomTask {
  id                   String    @id
  name                 String
  course               String
  due                  String?
  dueAt                DateTime?
  dueFraction          Float?
  sourceAnnouncementId String?
  // Set when this task was inserted/accepted from an AI-detected candidate
  // and the user has dismissed the "AI-detected" badge on its card
  // (implicit confirmation it's correct) — distinct from the task later
  // being deleted outright (implicit signal it was wrong), both logged via
  // AiTaskEvent for the accuracy-tracking work in AutoTaskCreation.md.
  aiTagDismissedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set when this row is a materialized occurrence of a RecurringTask
  // (id shape "custom-r<recurringTaskId>-<due>", see lib/recurrence.ts).
  // onDelete: SetNull so deleting a whole series never deletes historical/
  // completed occurrences, only unlinks them.
  recurrenceId         String?
  recurringTask        RecurringTask? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  // Set when this single occurrence was edited via the "this occurrence
  // only" scope on a field the series would otherwise control (name/course/
  // type/due date/time) — a later "this and following" bulk edit on the
  // series must skip any row with this flag set, or it silently clobbers a
  // deliberate per-occurrence customization.
  recurrenceOverridden Boolean        @default(false)

  @@index([userId])
  @@index([recurrenceId])
}

// Template a recurring task's occurrences are generated from. Occurrences
// themselves are real CustomTask rows (see recurrenceId above) generated
// client-side (components/WeeklyPlannerView.tsx) rather than expanded
// virtually at render time — dueAt/dueFraction resolution must stay
// client-side per lib/utils.ts's resolveDueTime (no server-side timezone
// guessing anywhere in this app), and materializing real rows means every
// occurrence gets full AssignmentCard/grid-packing/TaskCustomization/
// priority/XP behavior for free, with zero special-casing of
// id.startsWith("custom-") call sites elsewhere in the app.
model RecurringTask {
  id           String   @id @default(cuid())
  name         String
  course       String
  // HW/R/EXAM/TODO, same domain as Assignment.typeOverride — no enum in
  // this schema (see TaskCustomization.typeOverride), validated in-route.
  typeOverride String?
  // "daily" | "weekly" | "monthly" — validated in-route, see lib/recurrence.ts.
  frequency    String
  // Every N days/weeks/months, >= 1.
  interval     Int      @default(1)
  // 0=Sun..6=Sat (app's Sunday-start convention, lib/utils.ts's
  // getStartOfWeek) — only consulted when frequency === "weekly".
  weekdays     Int[]    @default([])
  // "YYYY-MM-DD" — first occurrence / recurrence anchor, same plain-date
  // convention as CustomTask.due.
  startDate    String
  // "YYYY-MM-DD" inclusive, null = no end (rolling-horizon generation).
  endDate      String?
  // "HH:MM", null = end of day — fed into resolveDueTime per occurrence.
  dueTime      String?
  // Paused = stop generating new occurrences, keep existing history.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  occurrences CustomTask[]

  @@index([userId])
}

// AI importance/difficulty/time estimates — was localStorage-only
// (task_planning_estimates), same cross-device-loss reasoning as
// CustomTask above. `signature` (lib/taskPlanning.ts's getTaskSignature)
// detects when a task's name/course changed enough to need re-estimating.
model TaskPlanningEstimate {
  id               String   @id @default(cuid())
  taskId           String
  signature        String
  estimatedMinutes Int
  importance       Int
  difficulty       Int
  consequence      Int
  reason           String
  assignmentType   String?
  priorityScore    Float
  urgencyScore     Float
  frogScore        Float
  priorityReason   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

// One row per completion record (not one row per task type) — was
// localStorage-only (procrastination_history). The rolling 12-per-type
// cap (lib/procrastinationHistory.ts's MAX_RECORDS_PER_TYPE) is enforced
// server-side on insert instead of client-side array slicing.
model ProcrastinationRecord {
  id          String   @id @default(cuid())
  taskType    String
  addedAt     DateTime
  dueAt       DateTime
  completedAt DateTime
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, taskType])
}

// One row per user (not one per task, unlike TaskCustomization) — was
// plain localStorage (lib/gamification.ts), unscoped to the logged-in
// user; moved here since gamification is becoming the centerpiece of the
// app and losing/mixing a semester of earned progress on a shared
// browser or account switch is no longer acceptable.
model GamificationState {
  id             String   @id @default(cuid())
  totalXp        Int      @default(0)
  // Assignment.id (Canvas-synced) or a client-generated "custom-<timestamp>"
  // id, same free-form convention as TaskCustomization.taskId.
  awardedTaskIds String[]
  updatedAt      DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Medieval-kingdom gamification layer (gamificationSystem.md). Deliberately a
// separate model from GamificationState rather than an extension of it, so
// GamificationState's existing PATCH validator/full-row-replace never has to
// change and can't accidentally wipe real XP data.
model TownState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency Int @default(0)

  // Typed growth counters, one per building. townSquareGrowth is both the
  // TODO-task bucket and the general-activity anchor (see lib/townGrowth.ts).
  libraryGrowth         Int @default(0)
  workshopGrowth        Int @default(0)
  trainingGroundsGrowth Int @default(0)
  watchtowerGrowth      Int @default(0)
  townSquareGrowth      Int @default(0)

  // Village/Town/City/Kingdom, gated by a completion-count milestone
  // checkpoint rather than derived live from growth (see
  // maybeAdvanceKingdomStage in lib/townGrowth.ts) — only ever advances
  // forward.
  kingdomStage String @default("village")

  onboardingCompletedAt DateTime?
  updatedAt             DateTime  @updatedAt
}

// The user-designed World map (ground theme, decorations, building-stage
// art, growth-gated scatter houses, the wall) — edited via /dev/map-editor,
// read by TownMap.tsx to render the real World view. A single JSON blob,
// not relational rows like TaskCustomization: this is one artifact one
// user designs in one sitting, so a full-row replace on save is the
// expected behavior here, not the stale-snapshot hazard it would be for
// concurrently-edited task data.
model WorldLayout {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  data      Json
  updatedAt DateTime @updatedAt
}

// Lodestar's reward layer (gamificationSystem.md), replacing TownState in
// the live app. Starlight is only ever changed server-side by increment/
// decrement (app/api/star-chart) — never by a client sending a new total —
// so a stale client copy can't undo a purchase or double an award.
model StarChart {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  starlight         Int       @default(0)
  // Total ever earned, never decremented; drives constellation unlocks.
  lifetimeStarlight Int       @default(0)
  onboardedAt       DateTime?
  updatedAt         DateTime  @updatedAt
}

// constellationId is a key into lib/constellations.ts's catalog.
model ChartedStar {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  constellationId String
  starIndex       Int
  chartedAt       DateTime @default(now())

  @@unique([userId, constellationId, starIndex])
  @@index([userId])
}

model MusicPlaylist {
  id        String   @id @default(cuid())
  name      String
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tracks MusicTrack[]

  @@index([userId])
}

model MusicTrack {
  id        String  @id @default(cuid())
  title     String
  sourceUrl String
  thumbnail String?
  position  Int     @default(0)

  playlistId String
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId])
}

// One row per user (TownState/GamificationState singleton pattern) —
// deliberately separate from both, since this is neither gamification nor
// world-layout state. Backs AutoTaskCreation.md's "auto-accept" setting and
// the Rundown screen's "anything new since last visit" gate.
model PlannerSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Default OFF per AutoTaskCreation.md: skips Yes/No/Maybe specifically
  // for high-confidence AI-detected candidates (see lib/rundownAutoAccept.ts)
  // — never affects the "Added from Canvas" section.
  autoAcceptAiTasks   Boolean   @default(false)
  // Plays public/sounds/completion-ding.mp3 on a fresh task completion.
  completionSound     Boolean   @default(true)
  // Null = never viewed — everything currently pending/added counts as
  // "new," which is also the correct behavior for a first-ever login.
  lastRundownViewedAt DateTime?
  updatedAt           DateTime  @updatedAt
}

// Durable event log for the Rundown/auto-task-creation feature's accuracy
// tracking (AutoTaskCreation.md's "Logging" section) and for the manual
// detection-pass rate limit (lib/aiRateLimit.ts counts
// "detection_pass_triggered" rows) — deliberately not a console.log, since
// the whole point is answering "is this feature pulling its weight" with
// real numbers later. `data` is a free-form per-`type` payload rather than
// a wide sparse column set, since each event type carries different fields.
model AiTaskEvent {
  id                   String   @id @default(cuid())
  // "detection_pass_triggered" | "candidate_decided" | "maybe_resolved" |
  // "ai_tag_dismissed" | "ai_task_deleted"
  type                 String
  sourceAnnouncementId String?
  suggestionKey        String?
  // CustomTask.id, for ai_tag_dismissed/ai_task_deleted events.
  taskId               String?
  data                 Json?
  createdAt            DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}
