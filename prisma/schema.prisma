generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  extensionSessions ExtensionSession[]
  canvasCourses     CanvasCourse[]
  assignments       Assignment[]
  discussions       Discussion[]
  announcements     Announcement[]
  musicPlaylists MusicPlaylist[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExtensionSession {
  id        String   @id @default(cuid())
  token     String   @unique
  state     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CanvasCourse {
  id              String   @id @default(cuid())
  canvasId        String
  canvasOrigin    String
  name            String
  // User-controlled: hide a course Canvas still reports as active (e.g. a
  // teacher never concluded it) without it reappearing on the next sync.
  hidden          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments     Assignment[]
  discussions     Discussion[]
  announcements   Announcement[]

  @@unique([userId, canvasOrigin, canvasId])
  @@index([userId])
}

model Assignment {
  id              String   @id @default(cuid())
  canvasId        String
  name            String
  description     String?
  dueAt           DateTime?
  htmlUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId        String
  course          CanvasCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([userId])
}

model Discussion {
  id          String        @id @default(cuid())
  canvasId    String
  title       String
  message     String?
  htmlUrl     String?
  postedAt    DateTime?
  dueAt       DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId    String
  course      CanvasCourse  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([userId])
}

model Announcement {
  id              String   @id @default(cuid())
  canvasId        String
  title           String
  message         String?
  htmlUrl         String?
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId        String
  course          CanvasCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, canvasId])
  @@index([userId])
}

model MusicPlaylist {
  id        String   @id @default(cuid())
  name      String
  sourceUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tracks MusicTrack[]

  @@index([userId])
}

model MusicTrack {
  id         String   @id @default(cuid())
  title      String
  sourceUrl  String
  thumbnail  String?
  position   Int      @default(0)

  playlistId String
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId])
}