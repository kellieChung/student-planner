{
  "manifest_version": 3,
  "name": "Student Planner Canvas",
  "version": "0.1.0",
  "description": "Connects Canvas to Student Planner.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"]
    }
  ]
}