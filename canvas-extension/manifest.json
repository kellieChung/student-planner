{
  "manifest_version": 3,
  "name": "Student Planner Canvas",
  "version": "0.1.0",
  "description": "Connects Canvas to Student Planner.",

  "permissions": [
    "storage",
    "identity",
    "scripting"
  ],

  "host_permissions": [
    "https://*/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "js": ["theme-sync.js"]
    }
  ]
}